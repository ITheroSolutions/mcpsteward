{
  "name": "mcpsteward",
  "version": "0.1.1",
  "description": "Local-first MCP server inspection and trust toolkit. Conformance grading against the 2026-07-28 specification plus a tamper-evident surface ledger. No cloud, no account, no LLM.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "conformance",
    "security",
    "supply-chain",
    "tool-poisoning",
    "audit",
    "cli"
  ],
  "license": "MIT",
  "author": "IThero Solutions (https://github.com/ITheroSolutions)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "mcpsteward": "dist/cli/index.js",
    "mcpsteward-mcp": "dist/mcp/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json",
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js"
    },
    "./trust": {
      "types": "./dist/trust/index.d.ts",
      "import": "./dist/trust/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "import": "./dist/migration/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run verify",
    "docs": "typedoc",
    "docs:rules": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8",
    "typedoc": "0.27.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITheroSolutions/mcpsteward.git"
  },
  "homepage": "https://github.com/ITheroSolutions/mcpsteward#readme",
  "bugs": {
    "url": "https://github.com/ITheroSolutions/mcpsteward/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
